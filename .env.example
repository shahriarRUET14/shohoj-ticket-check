# Copy to `.env` and fill in values. `main.py` loads this file automatically (python-dotenv).
# Required when a trip-count change should be posted to Discord:
DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override journey date for all routes (Shohoz format: DD-MMM-YYYY).
# OVERRIDE_DATE=30-May-2026

# Optional: one-shot — run once with this set to post a test message to Discord, then remove it.
# DISCORD_TEST_MESSAGE=1

# Optional: send a Discord embed the first time each route+journey date is stored.
# NOTIFY_ON_BASELINE=1

# Discord: true/1 = summary embed every successful check; false/0 = only when trip count changes (legacy).
DISCORD_NOTIFY_EVERY_CHECK=true

# Legacy alias (optional, ignored if DISCORD_NOTIFY_EVERY_CHECK is set):
# DISCORD_REPORT_EVERY_RUN=false
